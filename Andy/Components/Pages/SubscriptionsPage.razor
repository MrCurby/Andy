@page "/Subscriptions"
@rendermode InteractiveServer
@using Andy.Core.DTOs
@using Andy.Core.Interfaces
@using Andy.Mapper
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@inject ILogger<SubscriptionsPage> Logger
@inject SubscriptionMapper SubscriptionMapper
@inject ISubscitionService SubscriptionService

<style>
    .subscriptions-layout {
        display: flex;
        gap: 16px;
        align-items: flex-start;
        flex-wrap: wrap;
        width: 100%;
        box-sizing: border-box;
    }

    .list-column {
        flex: 1 1 380px;
        min-width: 300px;
        max-width: 65%;
        box-sizing: border-box;
    }

    .editor-column {
        flex: 1 1 360px;
        min-width: 300px;
        max-width: 35%;
        box-sizing: border-box;
    }

    .list-scroll {
        max-height: calc(100vh - 200px);
        overflow-y: auto;
    }

    .subscription-card {
        padding: 8px 12px;
        width: 100%;
        max-width: 400px;
        min-width: 250px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
    }

    .vertical-divider {
        height: 80%;
        align-self: center;
    }

    @@media (max-width: 900px) {
        .list-column,
        .editor-column {
            flex-basis: 100%;
            max-width: 100%;
            min-width: 0;
        }

        .list-scroll {
            max-height: none;
        }

        .vertical-divider {
            display: none;
        }
    }
</style>

<BasePage Title="Subsciption" Icon="@(new Icons.Regular.Size28.CoinMultiple())">
    <TitleContent>
        <FluentButton Appearance="Appearance.Accent"
                      @onclick="NewSubscription"
                      IconStart="@(new Icons.Regular.Size28.Add())">
            Abo hinzufügen
        </FluentButton>
    </TitleContent>
    <ChildContent>
        @if (SubscriptionList == null)
        {
            <FluentProgressRing />
            <p>Lade Abonnements...</p>
        }
        else
        {
            <div class="subscriptions-layout">
                @* Linke Spalte: Liste + Scrollbereich *@
                <div class="list-column">
                    <div class="list-scroll">
                        <FluentStack Orientation="Orientation.Vertical" Style="margin-bottom:12px;">
                            <FluentLabel Typo="Typography.PaneHeader">Gesamtsumme: @SubscriptionList.Where(s => s.IsActive == true).Sum(s => s.Amount ?? 0).ToString("C") (Monatlich)</FluentLabel>
                        </FluentStack>

                        <FluentStack Orientation="Orientation.Vertical" Style="margin-bottom:12px;">
                            <FluentLabel Typo="Typography.PaneHeader">Aktive Einträge (@(SubscriptionList.Count(s => s.IsActive == true)))</FluentLabel>
                        </FluentStack>

                        @foreach (var Subscription in SubscriptionList.Where(sl => sl.IsActive == true))
                        {
                            <SubscriptionCard Subscription="Subscription"
                                              OnEdit="@(() => Edit(Subscription))"
                                              OnDelete="@(() => DeleteSubscriptionAsync(Subscription))"
                                              OnDeactivate="@(() => DeaktivateAsync(Subscription))" />
                        }

                        <FluentStack Orientation="Orientation.Vertical" Style="margin-bottom:12px; margin-top:12px;">
                            <FluentLabel Typo="Typography.PaneHeader">Inaktive Einträge (@(SubscriptionList.Count(s => s.IsActive == false)))</FluentLabel>
                        </FluentStack>

                        @foreach (var Subscription in SubscriptionList.Where(sl => sl.IsActive == false))
                        {
                            <SubscriptionCard Subscription="Subscription"
                                              OnEdit="@(() => Edit(Subscription))"
                                              OnDelete="@(() => DeleteSubscriptionAsync(Subscription))"
                                              OnActivate="@(() => AktivateAsync(Subscription))" />
                        }
                    </div>
                </div>

                <FluentDivider Class="vertical-divider" Orientation="Orientation.Vertical" Style="margin:0 8px;" />

                @* Rechte Spalte: Editor-Komponente *@
                <div class="editor-column">
                    <SubscriptionEditor SelectedSubscription="_selectedSubscription"
                                        EditMode="_editMode"
                                        OnSave="SaveAsync"
                                        OnCancel="CancelEdit" />
                </div>
            </div>
        }
    </ChildContent>
</BasePage>