@using Andy.ViewModels
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@using Microsoft.AspNetCore.Components

<FluentCard Class="subscription-card">
    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="justify-content:space-between; gap: 8px;">
        <FluentStack Orientation="Orientation.Vertical" Style="min-width:0; flex-grow:1;">
            <FluentLabel Typo="Typography.PaneHeader" Style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@Subscription.Name</FluentLabel>
            <FluentLabel Typo="Typography.Body" Style="overflow-wrap:break-word; color:var(--neutral-foreground-2);">@Subscription.Memo</FluentLabel>
        </FluentStack>

        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="HorizontalAlignment.End" Style="gap:8px;">
            <FluentLabel Typo="Typography.Subject" Style="text-align:right; white-space:nowrap;">@Subscription.Amount?.ToString("C")</FluentLabel>

            <FluentStack Orientation="Orientation.Vertical" Style="gap:4px;">
                <FluentButton Appearance="Appearance.Lightweight"
                              Color="@(Color.Success.ToAttributeValue())"
                              OnClick="() => OnEdit.InvokeAsync(Subscription)"
                              Title="Bearbeiten"
                              Style="padding:6px 8px; min-width:80px;">
                    Bearbeiten
                </FluentButton>
                <FluentButton Appearance="Appearance.Lightweight"
                              Color="@(Color.Error.ToAttributeValue())"
                              OnClick="() => OnDelete.InvokeAsync(Subscription)"
                              Title="Löschen"
                              Style="padding:6px 8px; min-width:80px;">
                    Löschen
                </FluentButton>
            </FluentStack>

            @if (Subscription.IsActive == true)
            {
                <FluentButton Color="@Color.Success.ToAttributeValue()"
                              IconStart="@(new Icons.Regular.Size28.Pause())"
                              Appearance="Appearance.Accent"
                              Style="height:60px;"
                              OnClick="() => OnDeactivate.InvokeAsync(Subscription)">
                </FluentButton>
            }
            else
            {
                <FluentButton Color="@Color.Success.ToAttributeValue()"
                              IconStart="@(new Icons.Regular.Size28.Play())"
                              Appearance="Appearance.Accent"
                              Style="height:60px;"
                              OnClick="() => OnActivate.InvokeAsync(Subscription)">
                </FluentButton>
            }
        </FluentStack>
    </FluentStack>
</FluentCard>

@code {
    [Parameter, EditorRequired]
    public SubscriptionViewModel Subscription { get; set; } = default!;

    [Parameter]
    public EventCallback<SubscriptionViewModel> OnEdit { get; set; }

    [Parameter]
    public EventCallback<SubscriptionViewModel> OnDelete { get; set; }

    [Parameter]
    public EventCallback<SubscriptionViewModel> OnActivate { get; set; }

    [Parameter]
    public EventCallback<SubscriptionViewModel> OnDeactivate { get; set; }
}